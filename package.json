    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.31.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
